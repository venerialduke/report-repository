{
  "name": "insights-hub",
  "private": true,
  "type": "module",
  "description": "Parcel & Pine Insights Hub — static report catalogue for GitHub Pages",
  "scripts": {
    "build": "node scripts/build-catalog.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/validate.mjs && node scripts/build-catalog.mjs",
    "new": "node scripts/new-report.mjs",
    "serve": "python3 -m http.server 8000",
    "summaries": "node scripts/generate-summaries.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
